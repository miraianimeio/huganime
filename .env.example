# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000

# MyAnimeList API v2 — https://myanimelist.net/apiconfig
# Create an app to get a Client ID. Not used by HugAnime yet.
# MAL sends no CORS headers, so this credential is for SERVER-SIDE use only.
MAL_CLIENT_ID=

# Client ids are 32 hex characters.
# MAL_CLIENT_ID_SKIP_VALIDATION=1 bypasses that check if MAL changes the format.

# Optional tuning
CACHE_TTL_DETAILS_MS=43200000
CACHE_TTL_LIST_MS=900000
JIKAN_MIN_INTERVAL_MS=400
# CACHE_STALE_GRACE_MS=2592000000

# --- HugAnime-specific ---
# Some embed hosts want a referrer when the server-check probes them.
REFERER=
# ANIKOTO_API=https://anikotoapi.site
# ANIKOTO_MAX_PAGES=400
# ANIKOTO_PER_PAGE=100
# ANIKOTO_CRAWL_GAP_MS=2300
# ANIKOTO_RATE_WAIT_MS=30000
# ANISKIP_API=https://api.aniskip.com
